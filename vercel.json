{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd dashboard && npm install && npm run build",
  "outputDirectory": "dashboard/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://aeris-l2o5.onrender.com/auth/:path*"
    },
    {
      "source": "/attendance/:path*",
      "destination": "https://aeris-l2o5.onrender.com/attendance/:path*"
    },
    {
      "source": "/biometric/:path*",
      "destination": "https://aeris-l2o5.onrender.com/biometric/:path*"
    },
    {
      "source": "/devices/:path*",
      "destination": "https://aeris-l2o5.onrender.com/devices/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://aeris-l2o5.onrender.com/admin/:path*"
    },
    {
      "source": "/registry/:path*",
      "destination": "https://aeris-l2o5.onrender.com/registry/:path*"
    },
    {
      "source": "/gate/:path*",
      "destination": "https://aeris-l2o5.onrender.com/gate/:path*"
    },
    {
      "source": "/health",
      "destination": "https://aeris-l2o5.onrender.com/health"
    },
    {
      "source": "/admin-portal/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/admin-portal/campus_overview.jpg",
      "destination": "/campus_overview.jpg"
    },
    {
      "source": "/admin-portal/campus_floor_3d.jpg",
      "destination": "/campus_floor_3d.jpg"
    },
    {
      "source": "/admin-portal/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/admin-portal/icons.svg",
      "destination": "/icons.svg"
    },
    {
      "source": "/admin-portal/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/admin-portal",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
