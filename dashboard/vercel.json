{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://zubxv3c-anonymous-8081.exp.direct/auth/:path*"
    },
    {
      "source": "/attendance/:path*",
      "destination": "https://zubxv3c-anonymous-8081.exp.direct/attendance/:path*"
    },
    {
      "source": "/biometric/:path*",
      "destination": "https://zubxv3c-anonymous-8081.exp.direct/biometric/:path*"
    },
    {
      "source": "/devices/:path*",
      "destination": "https://zubxv3c-anonymous-8081.exp.direct/devices/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://zubxv3c-anonymous-8081.exp.direct/admin/:path*"
    },
    {
      "source": "/registry/:path*",
      "destination": "https://zubxv3c-anonymous-8081.exp.direct/registry/:path*"
    },
    {
      "source": "/gate/:path*",
      "destination": "https://zubxv3c-anonymous-8081.exp.direct/gate/:path*"
    },
    {
      "source": "/health",
      "destination": "https://zubxv3c-anonymous-8081.exp.direct/health"
    },
    {
      "source": "/admin-portal/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/admin-portal/campus_overview.jpg",
      "destination": "/campus_overview.jpg"
    },
    {
      "source": "/admin-portal/campus_floor_3d.jpg",
      "destination": "/campus_floor_3d.jpg"
    },
    {
      "source": "/admin-portal/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/admin-portal/icons.svg",
      "destination": "/icons.svg"
    },
    {
      "source": "/admin-portal/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/admin-portal",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
